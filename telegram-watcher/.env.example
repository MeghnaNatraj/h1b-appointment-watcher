# Copy to .env (chmod 600) and fill in real values. Never commit .env.

# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=your_telegram_api_hash
SOURCE_GROUP=Regular_H1B_H4_VisaSlotsChecking

# Private ntfy.sh topic the Visa Alarm app listens on. Any long random name
# works and acts as the password, e.g. visa-alert-$(openssl rand -hex 8)
NTFY_TOPIC=

# Read each screenshot with the free tesseract program (must be installed) and send
# a "Slot details" line (location and dates). Alerts go out unchanged if it fails.
OCR_ENABLED=true

# Dead-man's-switch ping URL (healthchecks.io). Pinged every 5 minutes while connected;
# healthchecks.io raises a down alert (its webhook rings the phone) when pings stop.
HEALTHCHECK_URL=

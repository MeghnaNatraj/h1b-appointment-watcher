# Copy to .env (chmod 600) and fill in real values. Never commit .env.

# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=your_telegram_api_hash
SOURCE_GROUP=Regular_H1B_H4_VisaSlotsChecking
# Send each alert to Saved Messages and the DM below (false = email/WhatsApp only)
TELEGRAM_COPIES_ENABLED=true
# Telegram @username (no @) that gets a DM per alert
TELEGRAM_RECIPIENT=your_telegram_username

# Email alerts on/off. Gmail sender and a Google app password (not the account password)
EMAIL_ENABLED=true
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
# Comma-separated list
EMAIL_RECIPIENTS=you@gmail.com,someone@example.com

# WhatsApp Cloud API (Meta). Disabled until the template is approved.
WA_ENABLED=false
WA_PHONE_NUMBER_ID=your_phone_number_id
# WhatsApp Business Account ID; used to announce once the first WA_TEMPLATE is approved
WA_BUSINESS_ACCOUNT_ID=your_waba_id
WA_RECIPIENT=15551234567
WA_ACCESS_TOKEN=your_whatsapp_access_token
# Comma-separated, tried in order; a template still in Meta review is skipped.
# h1b_slot_short and h1b_slot_update are Utility (deliver to US numbers);
# h1b_slot_alert is Marketing, which Meta does not deliver to +1 numbers.
WA_TEMPLATE=h1b_slot_short,h1b_slot_update,h1b_slot_alert
# Language code the template was created in (WhatsApp Manager shows "English" = en)
WA_LANGUAGE=en

# Telegram bot that sends each alert as a message you get notified for (your own
# account's copies never notify you). Create it with @BotFather, tap Start in its
# chat, then read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TG_BOT_TOKEN=
TG_BOT_CHAT_ID=

# Private ntfy.sh topic for the loud alarms (Android app and Mac alarm). Any long
# random name works and acts as the password, e.g. visa-alert-$(openssl rand -hex 8)
NTFY_TOPIC=

# Send a "still running" note every N days (0 = off), by WhatsApp if enabled, else email. Used on the cloud VM.
HEARTBEAT_DAYS=0

# Dead-man's-switch ping URL (healthchecks.io). Pinged every 5 minutes while connected;
# the service emails/WhatsApps you when pings stop.
HEALTHCHECK_URL=

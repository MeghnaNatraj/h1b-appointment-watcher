# Copy to .env (chmod 600) and fill in real values. Never commit .env.

# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=your_telegram_api_hash
SOURCE_GROUP=Regular_H1B_H4_VisaSlotsChecking
# Send each alert to Saved Messages and the DM below (off by default: Telegram never notifies you about your own messages)
TELEGRAM_COPIES_ENABLED=false
# Telegram @username (no @) that gets a DM per alert
TELEGRAM_RECIPIENT=your_telegram_username

# WhatsApp Cloud API (Meta). Disabled until the template is approved.
WA_ENABLED=false
WA_PHONE_NUMBER_ID=your_phone_number_id
# WhatsApp Business Account ID; used to tell you once the first WA_TEMPLATE is approved
WA_BUSINESS_ACCOUNT_ID=your_waba_id
WA_RECIPIENT=15551234567
WA_ACCESS_TOKEN=your_whatsapp_access_token
# Comma-separated, tried in order; a template still in Meta review is skipped.
# All Utility (Meta does not deliver Marketing templates to +1 numbers), shortest first:
# h1b_slot_update_complete "Update on your appointment alert: {{1}}. Complete."
WA_TEMPLATE=h1b_slot_update_complete,h1b_slot_min,h1b_slot_short,h1b_slot_update
# Language code the template was created in (WhatsApp Manager shows "English" = en)
WA_LANGUAGE=en

# Telegram bot that sends each alert as a message you get notified for (your own
# account's copies never notify you). Create it with @BotFather, tap Start in its
# chat, then read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# Set BOT_ENABLED=false to keep the token but stop all bot messages.
BOT_ENABLED=true
TG_BOT_TOKEN=
TG_BOT_CHAT_ID=

# Private ntfy.sh topic for the loud alarms (Android app). Any long
# random name works and acts as the password, e.g. visa-alert-$(openssl rand -hex 8)
NTFY_TOPIC=

# Read each screenshot with the free tesseract program (must be installed) and add a
# one-line summary (location, visa type, dates) to the alerts. Alerts go out unchanged if it fails.
OCR_ENABLED=true

# Send a "still running" note every N days (0 = off), by WhatsApp if enabled, else the Telegram bot and alarm.
HEARTBEAT_DAYS=0

# Dead-man's-switch ping URL (healthchecks.io). Pinged every 5 minutes while connected;
# healthchecks.io raises a down alert (its webhook rings the alarms) when pings stop.
HEALTHCHECK_URL=
